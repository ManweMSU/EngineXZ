resource string ErrorXXNotFound		[ _ ru ] { "Failed to locate the XX's configuration." "Не удалось обнаружить настройки XX." }
resource string ErrorSecUpdate		[ _ ru ] { "Failed to update the XX's configuration." "Не удалось обновить настройки XX." }

resource string MsgCertSigned		[ _ ru ] { "The certificate was successfully signed. Do you want to delete the unsigned certificate's file?" "Сертификат был успешно подписан. Желаете ли вы удалить неподписанный файл сертификата?" }
resource string MsgIdentityCreated	[ _ ru ] { "The identity was successfully created. Do you want to delete the certificate and the key files?" "Личность была создана успешно. Желаете ли вы удалить файлы сертификата и ключа?" }
resource string MsgCreateTrustPaths	[ _ ru ] { "The trust configuration seems to be missing. Do you want to create new folders for it?" "Вероятно, настройки безопасности отсутствуют. Желаете ли вы создать новые каталоги для них?" }

dialog Intro { DialogFrame {
	Captioned Title ApplicationName CloseButton MinimizeButton
	position { 0, 0, 3 * Interval z 250 z 128, 2 * Interval z 128 }
	ToolButton { style WaffleToolButtonS position { Interval, w 0.5 - 2 * ElementSize, Interval z 250, w 0.5 - ElementSize } ToolButtonPart { position parent Text IntroOpenFiles ID 101 } }
	ToolButton { style WaffleToolButtonS position { Interval, w 0.5 - ElementSize, Interval z 250, w 0.5 } ToolButtonPart { position parent Text IntroCreateCert ID 102 } }
	ToolButton { style WaffleToolButtonS position { Interval, w 0.5, Interval z 250, w 0.5 + ElementSize } ToolButtonPart { position parent Text IntroConfigure ID 103 } }
	ToolButton { style WaffleToolButtonS position { Interval, w 0.5 + ElementSize, Interval z 250, w 0.5 + 2 * ElementSize } ToolButtonPart { position parent Text IntroExit ID 2 } }
	Static { position { 2 * Interval z 250, Interval, 2 * Interval z 250 z 128, Interval z 128} Image MainIcon }
} }
dialog CreateCert { DialogFrame {
	Captioned Title CreateTitle Sizeble CloseButton MinimizeButton
	MinimalWidth z 400 MinimalHeight 7 * (Interval + ElementSize) + 2 * Interval MaximalWidth z 610 MaximalHeight 13 * (Interval + ElementSize) + 2 * Interval
	position { 0, 0, z 610, 13 * (Interval + ElementSize) + 2 * Interval }
	BookmarkView { position { Interval, Interval, w 1 - Interval, w 1 - 2 * Interval - ElementSize } ID 100
		Bookmark {
			position { 0, 0, z 100, 0 } Text CreateTabCert
			ScrollBox { position { 0, 0, w 1 - Interval2, w 1 } VerticalLine z 33
				Static { position { Interval, Interval, Interval z 100, Interval + ElementSize } Text CreatePerson }
				Edit { position { Interval z 100, Interval, w 1 - Interval2, Interval + ElementSize } ID 101 }
				Static { position { Interval, (Interval + ElementSize) + Interval, Interval z 100, 2 * (Interval + ElementSize) } Text CreateOrganization }
				Edit { position { Interval z 100, (Interval + ElementSize) + Interval, w 1 - Interval2, 2 * (Interval + ElementSize) } ID 102 }
				CheckBox { position { Interval, 2 * (Interval + ElementSize) + Interval, w 1 - Interval2, 3 * (Interval + ElementSize) } Text CreateRootCert ID 103 }
				Static { position { Interval, 3 * (Interval + ElementSize) + Interval, Interval z 100, 4 * (Interval + ElementSize) } Text CreateValidSince }
				Edit { position { Interval z 100, 3 * (Interval + ElementSize) + Interval, w 1 - Interval2, 4 * (Interval + ElementSize) } ID 104 }
				Static { position { Interval, 4 * (Interval + ElementSize) + Interval, Interval z 100, 5 * (Interval + ElementSize) } Text CreateValidUntil }
				Edit { position { Interval z 100, 4 * (Interval + ElementSize) + Interval, w 1 - Interval2, 5 * (Interval + ElementSize) } ID 105 }
				Static { position { Interval, 5 * (Interval + ElementSize) + Interval, w 1 - Interval2, 6 * (Interval + ElementSize) } Text CreateUsage }
				CheckBox { position { Interval, 6 * (Interval + ElementSize) + Interval, w 1 - Interval2, 7 * (Interval + ElementSize) } Text CreateUSignCerts ID 111 }
				CheckBox { position { Interval, 7 * (Interval + ElementSize) + Interval, w 1 - Interval2, 8 * (Interval + ElementSize) } Text CreateUSignModules ID 112 }
				Static { position { Interval, 8 * (Interval + ElementSize) + Interval, w 1 - Interval2, 9 * (Interval + ElementSize) } Text CreateUsageDeriv }
				CheckBox { position { Interval, 9 * (Interval + ElementSize) + Interval, w 1 - Interval2, 10 * (Interval + ElementSize) } Text CreateUSignCerts ID 121 }
				CheckBox { position { Interval, 10 * (Interval + ElementSize) + Interval, w 1 - Interval2, 11 * (Interval + ElementSize) } Text CreateUSignModules ID 122 }
			}
		}
		Bookmark {
			position { 0, 0, z 100, 0 } Text CreateTabEA
			ControlGroup { position parent
				ListView {
					position { Interval, Interval, w 1 - Interval, w 1 - 2 * Interval - ElementSize } ID 201
					ListViewColumn { position { 0, 0, z 200, 0 } MinimalWidth z 100 Text CreateEAKey ViewElementNormal {
						text { position { z 5, 0, w 1, w 1 } text @Text1 font @Font color TextNormal vcenter ellipsis }
					} }
					ListViewColumn { position { 0, 0, w 1 z -225, 0 } MinimalWidth z 100 Text CreateEAValue ViewElementNormal {
						text { position { z 5, 0, w 1, w 1 } text @Text2 font @Font color TextNormal vcenter ellipsis }
					} }
				}
				Edit { position { Interval, w 1 - Interval - ElementSize, Interval z 200, w 1 - Interval } ID 202 Placeholder CreateEAKey }
				Edit { position { 2 * Interval z 200, w 1 - Interval - ElementSize, w 1 - 3 * Interval - 2 * ElementSize, w 1 - Interval } ID 203 Placeholder CreateEAValue }
				Button { position { w 1 - 2 * Interval - 2 * ElementSize, w 1 - Interval - ElementSize, w 1 - 2 * Interval - ElementSize, w 1 - Interval } Text "+" ID 204 }
				Button { position { w 1 - Interval - ElementSize, w 1 - Interval - ElementSize, w 1 - Interval, w 1 - Interval } Text "-" ID 205 }
			}
		}
		Bookmark {
			position { 0, 0, z 100, 0 } Text CreateTabDS
			ControlGroup { position parent
				Static { position { Interval, Interval, Interval z 200, Interval + ElementSize } Text CreateDSA }
				ComboBox { position { Interval z 200, Interval, w 1 - Interval, Interval + ElementSize } ID 301 }
				Static { position { Interval, (Interval + ElementSize) + Interval, Interval z 200, 2 * (Interval + ElementSize) } Text CreateModulusLength }
				TextComboBox { position { Interval z 200, (Interval + ElementSize) + Interval, w 1 - Interval, 2 * (Interval + ElementSize) } ID 302 }
				Static { position { Interval, 2 * (Interval + ElementSize) + Interval, Interval z 200, 3 * (Interval + ElementSize) } Text CreatePublicExp }
				ComboBox { position { Interval z 200, 2 * (Interval + ElementSize) + Interval, w 1 - Interval, 3 * (Interval + ElementSize) } ID 303 }
				Static { position { Interval, 3 * (Interval + ElementSize) + Interval, Interval z 200, 4 * (Interval + ElementSize) } Text CreatePassword }
				Edit { position { Interval z 200, 3 * (Interval + ElementSize) + Interval, w 1 - Interval, 4 * (Interval + ElementSize) } ID 304 Password }
				Edit { position { Interval z 200, 4 * (Interval + ElementSize) + Interval, w 1 - Interval, 5 * (Interval + ElementSize) } ID 305 Password }
			}
		}
	}
	ControlGroup { position { Interval, Interval, w 1 - Interval, w 1 - 2 * Interval - ElementSize } style WaffleFrame ID 1000 Invisible
		RichEdit { position { Interval, Interval, w 1 - Interval, w 1 - Interval } ID 1001 ReadOnly DontCopyAttributes }
	}
	Button {
		position { Interval, w 1 - ElementSize - Interval, Interval z 100, w 1 - Interval }
		Text CreateButtonCancel ID 2
	}
	Button {
		position { w 1 z -100 - Interval, w 1 - ElementSize - Interval, w 1 - Interval, w 1 - Interval }
		Text CreateButtonCreate ID 1
	}
} }
dialog ViewStore { DialogFrame {
	Captioned Title ViewTitle Sizeble CloseButton MinimizeButton MaximizeButton
	MinimalWidth z 400 MinimalHeight z 300
	position { 0, 0, w 0.6, w 0.6 }
	HorizontalSplitBox { position { Interval - SplitBoxPadding, Interval - SplitBoxPadding, w 1 - (Interval - SplitBoxPadding), w 1 - (Interval - SplitBoxPadding) }
		SplitBoxPart { position { 0, 0, z 200, 0 } MinimalSize z 150 TreeView { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, w 1 - SplitBoxPadding } ID 101 } }
		SplitBoxPart { position { 0, 0, z 200, 0 } MinimalSize z 150 Stretch ControlGroup { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, w 1 - SplitBoxPadding } style WaffleFrame
			RichEdit { position { Interval, Interval, w 1 - Interval, w 1 - Interval } ID 102 ReadOnly DontCopyAttributes DefaultFontFace "@serif mono" }
		} }
	}
} }
dialog PasswordInput { DialogFrame {
	Captioned CloseButton position { 0, 0, z 360, 6 * Interval + 3 * ElementSize }
	ControlGroup { position { Interval, Interval, w 1 - Interval, 4 * Interval + 2 * ElementSize } style WaffleFrame
		Static { position { Interval, Interval, w 1 - Interval, Interval + ElementSize } Text PasswordTitle }
		Edit { position { Interval, 2 * Interval + ElementSize, w 1 - Interval, 2 * Interval + 2 * ElementSize } ID 101 Password }
	}
	Button {
		position { Interval, w 1 - ElementSize - Interval, Interval z 100, w 1 - Interval }
		Text PasswordCancel ID 2
	}
	Button {
		position { w 1 z -110, w 1 z -38, w 1 z -10, w 1 z -10 }
		Text PasswordEnter ID 1
	}
} }
dialog Settings { DialogFrame {
	Captioned Title SettingsTitle Sizeble CloseButton MinimizeButton
	MinimalWidth z 500 MinimalHeight 5 * (Interval + ElementSize) + 3 * Interval MaximalWidth z 1200 MaximalHeight 5 * (Interval + ElementSize) + 3 * Interval
	position { 0, 0, z 610, 5 * (Interval + ElementSize) + 3 * Interval }
	ControlGroup { position { Interval, Interval, w 1 - Interval, 4 * (Interval + ElementSize) + 2 * Interval } style WaffleFrame
		CheckBox { position { Interval, Interval, w 1 - Interval, Interval + ElementSize } Text SettingsValidate ID 101 }
		CheckBox { position { Interval, (Interval + ElementSize) + Interval, w 1 - Interval, 2 * (Interval + ElementSize) } Text SettingsValidateQr ID 104 }
		Static { position { Interval, 2 * (Interval + ElementSize) + Interval, Interval z 300, 3 * (Interval + ElementSize) } Text SettingsTrusted }
		Edit { position { Interval z 300, 2 * (Interval + ElementSize) + Interval, w 1 z -100 - 2 * Interval, 3 * (Interval + ElementSize) } ID 102 }
		Button { position { w 1 z -100 - Interval, 2 * (Interval + ElementSize) + Interval, w 1 - Interval, 3 * (Interval + ElementSize) } ID 202 Text SettingsView }
		Static { position { Interval, 3 * (Interval + ElementSize) + Interval, Interval z 300, 4 * (Interval + ElementSize) } Text SettingsUntrusted }
		Edit { position { Interval z 300, 3 * (Interval + ElementSize) + Interval, w 1 z -100 - 2 * Interval, 4 * (Interval + ElementSize) } ID 103 }
		Button { position { w 1 z -100 - Interval, 3 * (Interval + ElementSize) + Interval, w 1 - Interval, 4 * (Interval + ElementSize) } ID 203 Text SettingsView }
	}
	Button {
		position { Interval, w 1 - ElementSize - Interval, Interval z 100, w 1 - Interval }
		Text SettingsCancel ID 2
	}
	Button {
		position { w 1 z -100 - Interval, w 1 - ElementSize - Interval, w 1 - Interval, w 1 - Interval }
		Text SettingsApply ID 1
	}
} }