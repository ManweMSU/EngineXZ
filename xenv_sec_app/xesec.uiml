resource string ErrorInvalidCertReq	[ _ ru ] { "Either the certificate's or the digital signature's parameters are invalid." "Параметры сертификата или электронной подписи указаны некорректно." }
resource string ErrorInvalidCertKey	[ _ ru ] { "Failed to create an identity. It's likely a wrong password was supplied or the certificate contains a different public key." "Не удалось создать личность. Возможно, указан неверный пароль ключа или сертификат содержит иной публичный ключ." }
resource string ErrorInvalidIdent	[ _ ru ] { "Failed to open an identity. It's likely a wrong password was supplied." "Не удалось открыть личность. Возможно, указан неверный пароль ключа." }
