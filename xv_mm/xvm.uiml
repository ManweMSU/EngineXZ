dialog Editor { DialogFrame {
	position { 0, 0, w 0.7, w 0.7 }
	Captioned Sizeble CloseButton MaximizeButton MinimizeButton
	MinimalWidth z 450 MinimalHeight z 300
	FrameExtendedData { THEME_SPEC }
	MenuBar {
		position { 0, 0, w 1, ToolElementSize }
		MenuBarElement {
			Text MenuFile Menu { PopupMenu {
				MenuItem { SystemAppearance Text MenuNew RightText "Ctrl + Shift + N" ID 101 }
				MenuItem { SystemAppearance Text MenuOpen RightText "Ctrl + O" ID 102 }
				MenuItem { SystemAppearance Text MenuSave RightText "Ctrl + S" ID 103 }
				MenuItem { SystemAppearance Text MenuSaveAs RightText "Ctrl + Shift + S" ID 104 }
				MenuSeparator { SystemAppearance }
				MenuItem { SystemAppearance Text MenuExit ID 2 }
			} }
		}
		MenuBarElement {
			Text MenuEdit Menu { PopupMenu {
				MenuItem { SystemAppearance Text MenuAddPage ID 201 }
				MenuItem { SystemAppearance Text MenuAddSect ID 202 }
				MenuItem { SystemAppearance Text MenuAddLang ID 203 }
				MenuSeparator { SystemAppearance }
				MenuItem { SystemAppearance Text MenuRemPage ID 204 }
				MenuItem { SystemAppearance Text MenuRemSect ID 205 }
				MenuItem { SystemAppearance Text MenuRemLang ID 206 }
				MenuSeparator { SystemAppearance }
				MenuItem { SystemAppearance Text MenuMdlName ID 207 }
				MenuSeparator { SystemAppearance }
				MenuItem { SystemAppearance Text MenuNextElm RightText "F3" ID 208 }
			} }
		}
		MenuBarElement {
			Text MenuView Menu { PopupMenu {
				MenuItem { SystemAppearance Text MenuViewPg RightText "F5" ID 501 }
				MenuItem { SystemAppearance Text MenuViewAll RightText "Shift + F5" ID 502 }
			} }
		}
		MenuBarElement {
			Text MenuHelp Menu { PopupMenu {
				MenuItem { SystemAppearance Text MenuHelpDoc RightText "F1" ID 901 }
			} }
		}
	}
	HorizontalSplitBox {
		position { Interval - SplitBoxPadding, ToolElementSize + Interval - SplitBoxPadding, w 1 - (Interval - SplitBoxPadding), w 1 - (Interval - SplitBoxPadding) }
		SplitBoxPart {
			position { 0, 0, z 200, 0 }
			MinimalSize z 150
			TreeView { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, w 1 - SplitBoxPadding } ID 1001 }
		}
		SplitBoxPart {
			position { 0, 0, z 200, 0 }
			MinimalSize z 150 Stretch
			Edit { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, SplitBoxPadding + ElementSize } ID 1002 Placeholder TextTitle }
			CheckBox { position { SplitBoxPadding, SplitBoxPadding + ElementSize + Interval, SplitBoxPadding z 90, SplitBoxPadding + 2 * ElementSize + Interval } ID 1010 Text FlagThrows }
			CheckBox { position { SplitBoxPadding z 90, SplitBoxPadding + ElementSize + Interval, SplitBoxPadding z 180, SplitBoxPadding + 2 * ElementSize + Interval } ID 1011 Text FlagInst }
			CheckBox { position { SplitBoxPadding z 180, SplitBoxPadding + ElementSize + Interval, SplitBoxPadding z 270, SplitBoxPadding + 2 * ElementSize + Interval } ID 1012 Text FlagRead }
			CheckBox { position { SplitBoxPadding z 270, SplitBoxPadding + ElementSize + Interval, SplitBoxPadding z 360, SplitBoxPadding + 2 * ElementSize + Interval } ID 1013 Text FlagWrite }
			CheckBox { position { SplitBoxPadding z 360, SplitBoxPadding + ElementSize + Interval, SplitBoxPadding z 450, SplitBoxPadding + 2 * ElementSize + Interval } ID 1014 Text FlagVirtual }
			CheckBox { position { SplitBoxPadding, SplitBoxPadding + 2 * ElementSize + Interval, SplitBoxPadding z 90, SplitBoxPadding + 3 * ElementSize + Interval } ID 1015 Text FlagInterf }
			CheckBox { position { SplitBoxPadding z 90, SplitBoxPadding + 2 * ElementSize + Interval, SplitBoxPadding z 180, SplitBoxPadding + 3 * ElementSize + Interval } ID 1016 Text FlagCtor }
			CheckBox { position { SplitBoxPadding z 180, SplitBoxPadding + 2 * ElementSize + Interval, SplitBoxPadding z 270, SplitBoxPadding + 3 * ElementSize + Interval } ID 1017 Text FlagOper }
			CheckBox { position { SplitBoxPadding z 270, SplitBoxPadding + 2 * ElementSize + Interval, SplitBoxPadding z 360, SplitBoxPadding + 3 * ElementSize + Interval } ID 1018 Text FlagCast }
			HorizontalSplitBox {
				position { 0, 3 * ElementSize + 2 * Interval, w 1, w 1 }
				SplitBoxPart {
					position { 0, 0, z 150, 0 }
					MinimalSize z 80
					ListBox { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, w 1 - SplitBoxPadding } ID 1101 }
				}
				SplitBoxPart {
					position { 0, 0, z 150, 0 }
					MinimalSize z 60 Stretch
					ScrollBox { position { SplitBoxPadding, SplitBoxPadding, w 1 - SplitBoxPadding, w 1 - SplitBoxPadding } ID 1201 }
				}
			}
		}
	}
} }
dialog BaseMultiLine { MultiLineEdit {} }
dialog BaseStatic { Static {} }
dialog Browser { DialogFrame {
	position { 0, 0, w 0.7, w 0.7 }
	Captioned Sizeble CloseButton MaximizeButton MinimizeButton
	MinimalWidth z 300 MinimalHeight z 150 Background BrowserBackground
	FrameExtendedData { WindowsTabbedTitle WindowsTopMargin 2 * Interval + ElementSize MacEffectBackground MacEffectBackgroundMaterial "Sidebar" THEME_SPEC MacTransparentTitle }
	ToolButton { position { Interval, Interval, Interval + ElementSize, Interval + ElementSize } ToolButtonPart {
		position parent
		ImageNormal IconBack ImageGrayed IconBackI ID 101
	} }
	ToolButton { position { 2 * Interval + ElementSize, Interval, 2 * Interval + 2 * ElementSize, Interval + ElementSize } ToolButtonPart {
		position parent
		ImageNormal IconForward ImageGrayed IconForwardI ID 102
	} }
	Edit {
		position { 3 * Interval + 2 * ElementSize, Interval, w 1 - 4 * Interval - 3 * ElementSize, Interval + ElementSize }
		ID 103 ReadOnly Placeholder SearchText
	}
	ToolButton { position { w 1 - 3 * Interval - 3 * ElementSize, Interval, w 1 - 3 * Interval - 2 * ElementSize, Interval + ElementSize } ToolButtonPart {
		position parent
		ImageNormal IconHome ImageGrayed IconHomeI ID 104
	} }
	ToolButton { position { w 1 - 2 * Interval - 2 * ElementSize, Interval, w 1 - 2 * Interval - ElementSize, Interval + ElementSize } ToolButtonPart {
		position parent
		ImageNormal IconIndex ImageGrayed IconIndexI ID 105
	} }
	ToolButton { position { w 1 - Interval - ElementSize, Interval, w 1 - Interval, Interval + ElementSize } ToolButtonPart {
		position parent
		ImageNormal IconFind ImageGrayed IconFindI ID 106
	} }
	RichEdit {
		position { Interval, 2 * Interval + ElementSize, w 1 - Interval, w 1 - Interval }
		DontCopyAttributes ReadOnly ID 201
	}
} }