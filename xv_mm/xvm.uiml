application BrowserBackground Windows { bar { position { 0, 2 * Interval + ElementSize, w 1, w 1 } color ButtonC } }
application BrowserBackground MacOSX { frame { position parent } }
application BrowserBackground Linux { bar { position parent color ButtonC } }

dialog AddPage { DialogFrame {
	position { 0, 0, z 400, 6 * Interval + 3 * ElementSize }
	Captioned CloseButton Title MenuAddPage
	ControlGroup {
		style WaffleFrame
		position { Interval, Interval, w 1 - Interval, 4 * Interval + 2 * ElementSize }
		Static { position { Interval, Interval, Interval z 100, Interval + ElementSize } Text AddClass }
		ComboBox { position { Interval z 100, Interval, w 1 - Interval, Interval + ElementSize } ID 101 }
		Static { position { Interval, 2 * Interval + ElementSize, Interval z 100, 2 * (Interval + ElementSize) } Text AddPath }
		Edit { position { Interval z 100, 2 * Interval + ElementSize, w 1 - Interval, 2 * (Interval + ElementSize) } ID 102 Text "." }
	}
	Button {
		position { w 1 - 2 * Interval z -200, 5 * Interval + 2 * ElementSize, w 1 - 2 * Interval z -100, 5 * Interval + 3 * ElementSize }
		ID 2 Text ButtonCncl
	}
	Button {
		position { w 1 - Interval z -100, 5 * Interval + 2 * ElementSize, w 1 - Interval, 5 * Interval + 3 * ElementSize }
		ID 1 Text ButtonAdd
	}
} }
dialog AddSect { DialogFrame {
	position { 0, 0, z 400, 7 * Interval + 4 * ElementSize }
	Captioned CloseButton Title MenuAddSect
	ControlGroup {
		style WaffleFrame
		position { Interval, Interval, w 1 - Interval, 5 * Interval + 3 * ElementSize }
		Static { position { Interval, Interval, Interval z 100, Interval + ElementSize } Text AddClass }
		ComboBox { position { Interval z 100, Interval, w 1 - Interval, Interval + ElementSize } ID 101 }
		Static { position { Interval, 2 * Interval + ElementSize, Interval z 100, 2 * (Interval + ElementSize) } Text AddName }
		Edit { position { Interval z 100, 2 * Interval + ElementSize, w 1 - Interval, 2 * (Interval + ElementSize) } ID 102 }
		Static { position { Interval, 3 * Interval + 2 * ElementSize, Interval z 100, 3 * (Interval + ElementSize) } Text AddIndex }
		Edit { position { Interval z 100, 3 * Interval + 2 * ElementSize, w 1 - Interval, 3 * (Interval + ElementSize) } ID 103 CharactersEnabled "0123456789" Text "0" }
	}
	Button {
		position { w 1 - 2 * Interval z -200, 6 * Interval + 3 * ElementSize, w 1 - 2 * Interval z -100, 6 * Interval + 4 * ElementSize }
		ID 2 Text ButtonCncl
	}
	Button {
		position { w 1 - Interval z -100, 6 * Interval + 3 * ElementSize, w 1 - Interval, 6 * Interval + 4 * ElementSize }
		ID 1 Text ButtonAdd
	}
} }
dialog AddLang { DialogFrame {
	position { 0, 0, z 400, 5 * Interval + 2 * ElementSize }
	Captioned CloseButton Title MenuAddLang
	ControlGroup {
		style WaffleFrame
		position { Interval, Interval, w 1 - Interval, 3 * Interval + ElementSize }
		Static { position { Interval, Interval, Interval z 100, Interval + ElementSize } Text AddLang }
		Edit { position { Interval z 100, Interval, w 1 - Interval, Interval + ElementSize } ID 101 }
	}
	Button {
		position { w 1 - 2 * Interval z -200, 4 * Interval + ElementSize, w 1 - 2 * Interval z -100, 4 * Interval + 2 * ElementSize }
		ID 2 Text ButtonCncl
	}
	Button {
		position { w 1 - Interval z -100, 4 * Interval + ElementSize, w 1 - Interval, 4 * Interval + 2 * ElementSize }
		ID 1 Text ButtonAdd
	}
} }
dialog SetModuleName { DialogFrame {
	position { 0, 0, z 400, 5 * Interval + 2 * ElementSize }
	Captioned CloseButton Title TitleModule
	ControlGroup {
		style WaffleFrame
		position { Interval, Interval, w 1 - Interval, 3 * Interval + ElementSize }
		Edit { position { Interval, Interval, w 1 - Interval, Interval + ElementSize } ID 101 }
	}
	Button {
		position { w 1 - 2 * Interval z -200, 4 * Interval + ElementSize, w 1 - 2 * Interval z -100, 4 * Interval + 2 * ElementSize }
		ID 2 Text ButtonCncl
	}
	Button {
		position { w 1 - Interval z -100, 4 * Interval + ElementSize, w 1 - Interval, 4 * Interval + 2 * ElementSize }
		ID 1 Text ButtonAccpt
	}
} }
dialog RemoveLang { DialogFrame {
	position { 0, 0, z 400, 5 * Interval + 2 * ElementSize }
	Captioned CloseButton Title MenuRemLang
	ControlGroup {
		style WaffleFrame
		position { Interval, Interval, w 1 - Interval, 3 * Interval + ElementSize }
		Static { position { Interval, Interval, Interval z 100, Interval + ElementSize } Text AddLang }
